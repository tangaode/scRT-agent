def setup_style() -> None:
    plt.rcParams.update(
        {
            "figure.dpi": 130,
            "savefig.dpi": 320,
            "font.size": 9,
            "axes.titlesize": 10,
            "axes.labelsize": 9,
            "xtick.labelsize": 8,
            "ytick.labelsize": 8,
            "axes.spines.top": False,
            "axes.spines.right": False,
            "pdf.fonttype": 42,
            "ps.fonttype": 42,
        }
    )


def read_csv(path: Path) -> pd.DataFrame:
    if not path.exists():
        return pd.DataFrame()
    try:
        return pd.read_csv(path)
    except Exception:
        return pd.DataFrame()


def read_text(path: Path) -> str:
    if not path.exists():
        return ""
    return path.read_text(encoding="utf-8", errors="replace")


def read_json(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}


def write_csv(name: str, df: pd.DataFrame) -> None:
    BIO_DIR.mkdir(parents=True, exist_ok=True)
    df.to_csv(BIO_DIR / name, index=False)


def write_md(name: str, lines: list[str]) -> None:
    BIO_DIR.mkdir(parents=True, exist_ok=True)
    (BIO_DIR / name).write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")


def number(value, default: float = float("nan")) -> float:
    try:
        return float(value)
    except Exception:
        return default


def direction_label(value: float, positive: str = "higher", negative: str = "lower") -> str:
    if pd.isna(value):
        return "not available"
    if value > 1e-9:
        return positive
    if value < -1e-9:
        return negative
    return "similar"


def support_from_effect(value: float, expected_positive: bool = True, threshold: float = 0.05) -> str:
    if pd.isna(value):
        return "not assessed"
    if abs(value) < threshold:
        return "weak"
    if expected_positive and value > 0:
        return "supports"
    if (not expected_positive) and value < 0:
        return "supports"
    return "contrasts"


def selected_hypothesis() -> dict:
    deep = ANALYSIS_OUTPUTS / "deep_dive" / "selected_hypothesis.json"
    root = ANALYSIS_OUTPUTS.parent / "selected_hypothesis.json"
    return read_json(deep) or read_json(root)


def deep_decision_text() -> str:
    return read_text(ANALYSIS_OUTPUTS / "deep_dive" / "deep_dive_conclusion.md")


def build_signal_table() -> pd.DataFrame:
    rows = []
    focus = read_csv(ANALYSIS_OUTPUTS / "deep_dive" / "deep_focus_state_expanded_vs_singleton.csv")
    if not focus.empty and "clone_class" in focus:
        focus_state = str(focus.get("focus_state_rule", pd.Series(["focus-state"])).dropna().iloc[0])
        idx = focus.set_index("clone_class")
        if "expanded" in idx.index and "singleton" in idx.index:
            metrics = [
                ("scrta_score_cytotoxic", "cytotoxic program", True),
                ("scrta_score_exhaustion", "exhaustion/checkpoint program", True),
                ("scrta_score_memory_progenitor", "memory-progenitor program", False),
                ("scrta_score_interferon", "interferon program", True),
                ("scrta_score_proliferation", "proliferation program", True),
            ]
            for metric, label, expected_positive in metrics:
                col = f"mean_mean_{metric}"
                if col in idx:
                    diff = number(idx.loc["expanded", col]) - number(idx.loc["singleton", col])
                    rows.append(
                        {
                            "signal_id": f"focus_state_expanded_vs_singleton_{metric}",
                            "cell_axis": focus_state,
                            "comparison": "focus-state expanded clones versus singleton clones",
                            "program": label,
                            "effect": diff,
                            "direction": direction_label(diff),
                            "support": support_from_effect(diff, expected_positive=expected_positive),
                            "source_table": "deep_focus_state_expanded_vs_singleton.csv",
                        }
                    )

    private = read_csv(ANALYSIS_OUTPUTS / "deep_dive" / "deep_private_shared_clone_summary.csv")
    if not private.empty and "tissue_class" in private:
        treg = private[private["t_state"].astype(str).str.contains("Treg", case=False, na=False)]
        tumor = treg[treg["tissue_class"] == "tumor_private"]
        blood = treg[treg["tissue_class"] == "blood_private"]
        if not tumor.empty and not blood.empty:
            exp_diff = number(tumor["expanded_clone_fraction"].mean()) - number(blood["expanded_clone_fraction"].mean())
            rows.append(
                {
                    "signal_id": "Treg_tumor_private_expansion",
                    "cell_axis": "Treg-like",
                    "comparison": "tumor-private clones versus blood-private clones",
                    "program": "clone expansion",
                    "effect": exp_diff,
                    "direction": direction_label(exp_diff),
                    "support": support_from_effect(exp_diff, expected_positive=True),
                    "source_table": "deep_private_shared_clone_summary.csv",
                }
            )
            score_col = "clone_mean_mean_scrta_score_treg"
            if score_col in tumor and score_col in blood:
                score_diff = number(tumor[score_col].mean()) - number(blood[score_col].mean())
                rows.append(
                    {
                        "signal_id": "Treg_tumor_private_suppressive_program",
                        "cell_axis": "Treg-like",
                        "comparison": "tumor-private clones versus blood-private clones",
                        "program": "Treg suppressive program",
                        "effect": score_diff,
                        "direction": direction_label(score_diff),
                        "support": support_from_effect(score_diff, expected_positive=True),
                        "source_table": "deep_private_shared_clone_summary.csv",
                    }
                )

    tests = read_csv(ANALYSIS_OUTPUTS / "deep_dive" / "deep_patient_level_tests.csv")
    if not tests.empty and "test" in tests:
        same = tests[tests["test"] == "same_clone_tissue_program"].copy()
        for _, row in same.iterrows():
            pval = number(row.get("sign_test_p_two_sided", ""))
            effect = number(row.get("median_T_minus_P", ""))
            if pd.isna(effect):
                continue
            metric = str(row.get("metric", "")).replace("scrta_score_", "").replace("_T_minus_P", "")
            rows.append(
                {
                    "signal_id": f"same_clone_{row.get('t_state_pattern', '')}_{metric}",
                    "cell_axis": str(row.get("t_state_pattern", "")),
                    "comparison": "same clone tumor minus blood",
                    "program": metric.replace("_", " "),
                    "effect": effect,
                    "direction": "tumor higher" if effect > 0 else "tumor lower" if effect < 0 else "similar",
                    "support": "patient-significant" if pval <= 0.05 else "observed",
                    "source_table": "deep_patient_level_tests.csv",
                }
            )

    return pd.DataFrame(rows) if rows else pd.DataFrame(
        [
            {
                "signal_id": "no_signal_table",
                "cell_axis": "",
                "comparison": "",
                "program": "",
                "effect": "",
                "direction": "",
                "support": "not assessed",
                "source_table": "",
            }
        ]
    )


def marker_category(gene: str) -> str:
    gene = str(gene).upper().strip()
    for category, genes in PROGRAM_MARKERS.items():
        if gene in genes:
            return category
    return "other_or_dataset_specific"


def build_gene_program_table() -> pd.DataFrame:
    de = read_csv(ANALYSIS_OUTPUTS / "within_state_de_top_genes.csv")
    if de.empty or "gene" not in de:
        return pd.DataFrame(
            [{"program_category": "not_assessed", "genes": "", "n_genes": 0, "source_table": "within_state_de_top_genes.csv"}]
        )
    clean = de.copy()
    clean["program_category"] = clean["gene"].map(marker_category)
    rows = []
    group_cols = ["t_state", "contrast", "program_category"]
    for keys, df in clean.groupby([c for c in group_cols if c in clean], dropna=False):
        if not isinstance(keys, tuple):
            keys = (keys,)
        row = {}
        for col, value in zip([c for c in group_cols if c in clean], keys):
            row[col] = value
        genes = [str(x) for x in df.sort_values("abs_mean_diff", ascending=False).get("gene", pd.Series(dtype=str)).head(12)]
        row.update(
            {
                "n_genes": int(len(df)),
                "genes": ";".join(genes),
                "max_abs_mean_diff": number(df.get("abs_mean_diff", pd.Series([float("nan")])).max()),
                "source_table": "within_state_de_top_genes.csv",
            }
        )
        rows.append(row)
    return pd.DataFrame(rows) if rows else pd.DataFrame()


def evidence_lookup(signals: pd.DataFrame, pattern: str) -> list[dict]:
    if signals.empty or "signal_id" not in signals:
        return []
    mask = signals["signal_id"].astype(str).str.contains(pattern, case=False, regex=True)
    return signals[mask].to_dict(orient="records")


def confidence_score(items: list[dict]) -> tuple[int, str]:
    score = 0
    for item in items:
        support = str(item.get("support", ""))
        effect = abs(number(item.get("effect", 0), 0))
        if "supports" in support or "patient-significant" in support:
            score += 2
        elif "observed" in support or "weak" in support:
            score += 1
        if effect >= 0.25:
            score += 1
    if score >= 5:
        return score, "strong"
    if score >= 3:
        return score, "moderate"
    if score >= 1:
        return score, "exploratory"
    return score, "not supported by current tables"


def summarize_items(items: list[dict]) -> str:
    parts = []
    for item in items:
        effect = item.get("effect", "")
        try:
            effect_text = f"{float(effect):.3f}"
        except Exception:
            effect_text = str(effect)
        parts.append(
            f"{item.get('comparison', '')}: {item.get('program', '')} {item.get('direction', '')} ({effect_text}; {item.get('support', '')})"
        )
    return " | ".join(parts) if parts else "No direct signal in current tables."


def build_mechanism_map(signals: pd.DataFrame, gene_programs: pd.DataFrame) -> pd.DataFrame:
    mechanisms = []
    definitions = [
        {
            "mechanism_id": "M1_selected_hypothesis_rna_program_axis",
            "mechanism": "RNA program evidence relevant to the selected hypothesis",
            "pattern": "scrta_score_|program|within_state|expanded_vs_singleton|same_clone_",
            "interpretation": "RNA program shifts provide the primary phenotype layer for judging whether the selected hypothesis is biologically plausible in this dataset.",
            "downstream": "Run patient-aware module scoring, within-state contrasts, pseudobulk DE, and pathway enrichment targeted to the selected hypothesis.",
        },
        {
            "mechanism_id": "M2_tissue_or_context_program_axis",
            "mechanism": "Tissue, timepoint, or condition context associated with the selected hypothesis",
            "pattern": "tissue|timepoint|condition|tumor|blood|post|pre",
            "interpretation": "Context-stratified evidence helps determine whether the selected hypothesis is linked to tissue compartment, treatment timing, disease condition, or sample structure.",
            "downstream": "Model the selected RNA programs by patient, tissue, timepoint, and condition; report effect direction and patient consistency.",
        },
        {
            "mechanism_id": "M3_sctcr_support_layer",
            "mechanism": "scTCR lineage and state-occupancy support for the selected hypothesis",
            "pattern": "same_clone_",
            "interpretation": "Same-clone and clone-state evidence can support lineage anchoring, persistence, sharing, or state occupancy, but it does not prove antigen specificity or migration direction.",
            "downstream": "For shared or expanded clones, model RNA program changes within patient and context, then prioritize receptor follow-up only after RNA support is present.",
        },
        {
            "mechanism_id": "M4_candidate_gene_program_annotation",
            "mechanism": "Gene-level program annotation for selected-hypothesis follow-up",
            "pattern": "top_gene|gene|cytotoxic|exhaustion|memory|treg|interferon|residency|trafficking",
            "interpretation": "Top genes and curated programs can nominate molecular mechanisms that should be tested directly in downstream pathway analyses.",
            "downstream": "Run formal pathway enrichment or curated gene-set scoring for genes and programs tied to the selected hypothesis.",
        },
        {
            "mechanism_id": "M5_literature_testable_TCR_specificity_layer",
            "mechanism": "Potential antigen-linked receptor convergence requiring external specificity tests",
            "pattern": "clone|same_clone_|expanded|receptor|cdr3",
            "interpretation": "Clone expansion, sharing, and state coupling can nominate receptor lineages, but antigen specificity requires receptor-sequence or experimental evidence.",
            "downstream": "Use CDR3 alpha/beta, V/J genes, GLIPH2/TCRdist, VDJdb or McPAS-TCR matching, and external validation cohorts before claiming antigen recognition.",
        },
    ]
    for definition in definitions:
        items = evidence_lookup(signals, definition["pattern"])
        score, confidence = confidence_score(items)
        if definition["mechanism_id"] == "M5_literature_testable_TCR_specificity_layer":
            score = min(score, 2)
            confidence = "requires receptor-level validation"
        mechanisms.append(
            {
                "mechanism_id": definition["mechanism_id"],
                "mechanism": definition["mechanism"],
                "biological_interpretation": definition["interpretation"],
                "dataset_evidence": summarize_items(items),
                "evidence_score": score,
                "confidence": confidence,
                "recommended_downstream_analysis": definition["downstream"],
                "source_tables": "deep_dive outputs; within_state_de_top_genes.csv",
            }
        )
    if not gene_programs.empty and "program_category" in gene_programs:
        non_other = gene_programs[~gene_programs["program_category"].astype(str).isin(["other_or_dataset_specific", "not_assessed"])]
        if not non_other.empty:
            examples = []
            for _, row in non_other.head(8).iterrows():
                examples.append(f"{row.get('program_category', '')}: {row.get('genes', '')}")
            mechanisms.append(
                {
                    "mechanism_id": "M6_top_gene_program_annotation",
                    "mechanism": "Gene-level program annotation from within-state contrasts",
                    "biological_interpretation": "Top within-state genes overlap known immune programs and can guide targeted pathway follow-up.",
                    "dataset_evidence": " | ".join(examples),
                    "evidence_score": min(6, int(non_other["n_genes"].sum()) if "n_genes" in non_other else 1),
                    "confidence": "exploratory",
                    "recommended_downstream_analysis": "Run formal pathway enrichment or curated module scoring on the top genes from the relevant T state and contrast.",
                    "source_tables": "within_state_de_top_genes.csv",
                }
            )
    return pd.DataFrame(mechanisms)


