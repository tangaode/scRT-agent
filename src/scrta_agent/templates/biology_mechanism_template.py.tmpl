def make_figures(mechanism_df: pd.DataFrame, signals: pd.DataFrame) -> list[str]:
    created = []
    FIG_DIR.mkdir(parents=True, exist_ok=True)
    if not mechanism_df.empty and "evidence_score" in mechanism_df:
        plot = mechanism_df.sort_values("evidence_score", ascending=True).tail(8)
        plt.figure(figsize=(7.2, 4.0))
        plt.barh(plot["mechanism_id"], plot["evidence_score"], color="#486C85")
        plt.xlabel("Evidence score")
        plt.title("Mechanism evidence ranking")
        plt.tight_layout()
        plt.savefig(FIG_DIR / "mechanism_evidence_ranking.png", bbox_inches="tight")
        plt.savefig(FIG_DIR / "mechanism_evidence_ranking.pdf", bbox_inches="tight")
        plt.close()
        created.extend(["mechanism_evidence_ranking.png", "mechanism_evidence_ranking.pdf"])
    if not signals.empty and "effect" in signals:
        sig = signals.copy()
        sig["effect_numeric"] = pd.to_numeric(sig["effect"], errors="coerce")
        sig = sig.dropna(subset=["effect_numeric"]).head(16)
        if not sig.empty:
            plt.figure(figsize=(7.4, 4.2))
            labels = sig["signal_id"].astype(str).str.replace("_", " ", regex=False)
            colors = ["#7A3B3B" if x < 0 else "#3C6B4F" for x in sig["effect_numeric"]]
            plt.barh(labels, sig["effect_numeric"], color=colors)
            plt.axvline(0, color="#333333", lw=0.8)
            plt.xlabel("Effect direction")
            plt.title("Biological signals used for mechanism mapping")
            plt.tight_layout()
            plt.savefig(FIG_DIR / "biology_signal_effects.png", bbox_inches="tight")
            plt.savefig(FIG_DIR / "biology_signal_effects.pdf", bbox_inches="tight")
            plt.close()
            created.extend(["biology_signal_effects.png", "biology_signal_effects.pdf"])
    return created


def write_interpretation(selection: dict, decision_text: str, signals: pd.DataFrame, mechanism_df: pd.DataFrame, figures: list[str]) -> None:
    hypothesis = selection.get("selected_hypothesis", "No selected hypothesis was found.")
    decision_lines = [line for line in decision_text.splitlines() if "Supported" in line or "Partially" in line or "Inconclusive" in line]
    lines = [
        "# Biological Interpretation",
        "",
        "## Selected Hypothesis",
        hypothesis,
        "",
        "## Data-Supported Biological Meaning",
        "- Interpret these outputs against the selected hypothesis rather than as a fixed CD8/Treg template.",
        "- RNA programs and patient-aware contrasts are the primary evidence layer.",
        "- scTCR evidence is a supporting layer for lineage, persistence, clone expansion, shared-clone tracking, state occupancy, repertoire diversity, or receptor follow-up priority.",
        "- Clone expansion or sharing should not be interpreted as antigen specificity without external receptor-level validation.",
        "",
        "## Deep-Dive Decision Context",
    ]
    if decision_lines:
        lines.extend(f"- {line}" for line in decision_lines[:4])
    else:
        lines.append("- No calibrated deep-dive decision text was detected.")
    lines.extend(["", "## Key Signals"])
    if not signals.empty:
        for _, row in signals.head(12).iterrows():
            lines.append(
                f"- {row.get('signal_id', '')}: {row.get('comparison', '')}; {row.get('program', '')}; {row.get('direction', '')}; support={row.get('support', '')}."
            )
    lines.extend(["", "## Mechanism-Level Interpretation"])
    for _, row in mechanism_df.iterrows():
        lines.append(f"- {row['mechanism_id']}: {row['biological_interpretation']} Confidence: {row['confidence']}.")
    if figures:
        lines.extend(["", "## Figures"])
        lines.extend(f"- {figure}" for figure in figures)
    write_md("biological_interpretation.md", lines)


def write_mechanism_mapping(mechanism_df: pd.DataFrame, gene_programs: pd.DataFrame) -> None:
    lines = ["# Mechanism Mapping", ""]
    for _, row in mechanism_df.iterrows():
        lines.extend(
            [
                f"## {row['mechanism_id']}",
                f"- Mechanism: {row['mechanism']}",
                f"- Confidence: {row['confidence']} (score {row['evidence_score']})",
                f"- Dataset evidence: {row['dataset_evidence']}",
                f"- Recommended downstream analysis: {row['recommended_downstream_analysis']}",
                "",
            ]
        )
    lines.extend(["## Gene Program Annotations", ""])
    if gene_programs.empty:
        lines.append("- No gene-level program annotations were available.")
    else:
        for _, row in gene_programs.head(20).iterrows():
            label = " / ".join(str(row.get(c, "")) for c in ["t_state", "contrast", "program_category"] if c in row)
            lines.append(f"- {label}: {row.get('genes', '')}")
    write_md("mechanism_mapping.md", lines)


def write_next_tests(tests: pd.DataFrame) -> None:
    lines = ["# Next-Test Proposals", ""]
    for _, row in tests.iterrows():
        lines.extend(
            [
                f"## {row['priority']} {row['test_id']}",
                f"- Purpose: {row['purpose']}",
                f"- Analysis: {row['analysis']}",
                f"- Required inputs: {row['required_inputs']}",
                f"- Expected supporting result: {row['expected_supporting_result']}",
                f"- Runnable with current outputs: {row['runnable_with_current_outputs']}",
                f"- Linked mechanisms: {row.get('linked_mechanisms', '')}",
                "",
            ]
        )
    write_md("next_test_proposals.md", lines)


def main() -> None:
    setup_style()
    BIO_DIR.mkdir(parents=True, exist_ok=True)
    selection = selected_hypothesis()
    decision_text = deep_decision_text()
    signals = build_signal_table()
    gene_programs = build_gene_program_table()
    mechanisms = build_mechanism_map(signals, gene_programs)
    tests = build_next_tests(mechanisms)
    figures = make_figures(mechanisms, signals)

    write_csv("biological_signal_table.csv", signals)
    write_csv("mechanism_gene_program_table.csv", gene_programs)
    write_csv("mechanism_evidence_map.csv", mechanisms)
    write_csv("next_test_proposals.csv", tests)
    write_interpretation(selection, decision_text, signals, mechanisms, figures)
    write_mechanism_mapping(mechanisms, gene_programs)
    write_next_tests(tests)

    summary = {
        "selected_hypothesis": selection,
        "n_signals": int(len(signals)),
        "n_mechanisms": int(len(mechanisms)),
        "n_next_tests": int(len(tests)),
        "figures": figures,
        "outputs": [
            "biological_signal_table.csv",
            "mechanism_gene_program_table.csv",
            "mechanism_evidence_map.csv",
            "next_test_proposals.csv",
            "biological_interpretation.md",
            "mechanism_mapping.md",
            "next_test_proposals.md",
        ],
    }
    (BIO_DIR / "biological_mechanism_summary.json").write_text(json.dumps(summary, indent=2, ensure_ascii=False), encoding="utf-8")
    print(f"Wrote biological mechanism outputs to {BIO_DIR}")


if __name__ == "__main__":
    main()
